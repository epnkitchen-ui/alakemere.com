  .svc-dot{width:7px;height:7px;border-radius:50%;background:var(--gold);margin-top:5px}
  .svc-title{font-size:.72rem;font-weight:700;letter-spacing:.07em;color:var(--deep);margin-bottom:.3rem;text-transform:uppercase}
  .svc-body{font-size:.78rem;font-weight:300;line-height:1.8;color:rgba(92,51,23,.63)}
